---
import { decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Classic from "../layouts/Classic.astro";
import { fixUrls, postShell, toPost } from "../lib/classic";
import { loadPostEntries } from "../lib/data";

const slug = decodeSlug(Astro.params.slug);
const entry = (await loadPostEntries()).find((e) => e.id === slug);
if (!entry) return Astro.rewrite("/404");
const p = toPost(entry);
const shell = postShell(p);
---

<Classic
	title={p.title}
	description={p.excerpt}
	file={`post-${p.slug}.html`}
	ogImg={p.img}
	content={{ collection: "posts", id: entry.data.id, slug: entry.id }}
>
	<Fragment set:html={fixUrls(shell.head)} />
	<article class="article reveal"><PortableText value={entry.data.content} /></article>
	<Fragment set:html={fixUrls(shell.tail)} />
</Classic>
