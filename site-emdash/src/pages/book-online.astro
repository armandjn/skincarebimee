---
import Classic from "../layouts/Classic.astro";
import { bookBody, fixUrls } from "../lib/classic";
import { loadServices } from "../lib/data";

const S = await loadServices();
---

<Classic
	title="Book Online"
	description="Book your Skincare Bimee appointment online: facials, chemical peels, microdermabrasion, LED light therapy, Pro Pen Luminfusion, lip & eye, back treatments and free consultations."
	file="book-online.html"
	ogImg="hallway.jpg"
	services={S}
>
	<Fragment set:html={fixUrls(bookBody(S))} />
</Classic>
