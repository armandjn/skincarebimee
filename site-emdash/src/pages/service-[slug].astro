---
import { decodeSlug } from "emdash";
import Classic from "../layouts/Classic.astro";
import { SITE, fixUrls, money, serviceBody } from "../lib/classic";
import { loadServices } from "../lib/data";

const slug = decodeSlug(Astro.params.slug);
const S = await loadServices();
const s = S.find((x) => x.slug === slug);
if (!s) return Astro.rewrite("/404");
const desc = s.lead + (s.soon ? "" : ` ${s.dur} · ${money(s.price)} at ${SITE.name}, Plano TX.`);
---

<Classic title={s.name} description={desc} file={`service-${s.slug}.html`} ogImg={s.img} services={S}>
	<Fragment set:html={fixUrls(serviceBody(S, s))} />
</Classic>
