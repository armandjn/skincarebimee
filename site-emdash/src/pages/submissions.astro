---
import { env } from "cloudflare:workers";
import Classic from "../layouts/Classic.astro";

// Form submissions (bookings, messages, gift orders, subscribers). Signed-in EmDash users only.
if (!Astro.locals.user) return Astro.redirect("/_emdash/admin");
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const db = (env as { DB: D1Database }).DB;
const q = async (sql: string) => (await db.prepare(sql).all<Record<string, string | number | null>>()).results;
const [bookings, contacts, gifts, subscribers] = await Promise.all([
	q("SELECT * FROM bookings ORDER BY id DESC LIMIT 100"),
	q("SELECT * FROM contacts ORDER BY id DESC LIMIT 100"),
	q("SELECT * FROM gift_orders ORDER BY id DESC LIMIT 100"),
	q("SELECT * FROM subscribers ORDER BY id DESC LIMIT 200"),
]);
const tables = [
	["Bookings", bookings],
	["Messages", contacts],
	["Gift orders", gifts],
	["Subscribers", subscribers],
] as const;
---

<Classic title="Submissions" description="Form submissions" file="submissions.html" robots="noindex, nofollow">
	<section class="page-hero"><div class="container"><span class="eyebrow">Admin</span><h1>Submissions</h1></div></section>
	<div class="container" style="padding-block:3rem 5rem;display:grid;gap:2.5rem">
		{tables.map(([name, rows]) => (
			<section>
				<h2 style="font-family:var(--font-display);font-weight:500">{name} ({rows.length})</h2>
				{rows.length === 0 ? <p>Nothing yet.</p> : (
					<div style="overflow-x:auto">
						<table style="border-collapse:collapse;width:100%;font-size:.9rem">
							<thead><tr>{Object.keys(rows[0]).map((c) => <th style="text-align:left;padding:.4rem .6rem;border-bottom:1px solid var(--line)">{c}</th>)}</tr></thead>
							<tbody>{rows.map((r) => <tr>{Object.values(r).map((v) => <td style="padding:.4rem .6rem;border-bottom:1px solid var(--line);vertical-align:top">{v}</td>)}</tr>)}</tbody>
						</table>
					</div>
				)}
			</section>
		))}
	</div>
</Classic>
