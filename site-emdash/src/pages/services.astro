---
import Classic from "../layouts/Classic.astro";
import { fixUrls, servicesBody } from "../lib/classic";
import { loadServices } from "../lib/data";

const S = await loadServices();
---

<Classic
	title="Services & Treatments"
	description="Explore facials, Pro Pen Luminfusion, chemical peels, microdermabrasion, LED light therapy, lip & eye and back treatments at Skincare Bimee in Plano, TX."
	file="services.html"
	ogImg="facial.jpg"
	services={S}
>
	<Fragment set:html={fixUrls(servicesBody(S))} />
</Classic>
