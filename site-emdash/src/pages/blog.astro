---
import Classic from "../layouts/Classic.astro";
import { blogBody, fixUrls } from "../lib/classic";
import { loadPosts } from "../lib/data";

const posts = await loadPosts();
---

<Classic
	title="Journal"
	description="The Skincare Bimee journal: expert skincare tips, treatment guides and product insight."
	file="blog.html"
	ogImg="oils.jpg"
>
	<Fragment set:html={fixUrls(blogBody(posts))} />
</Classic>
