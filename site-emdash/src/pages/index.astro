---
import Classic from "../layouts/Classic.astro";
import { fixUrls, homeBody, jsonLd } from "../lib/classic";
import { loadPosts, loadServices } from "../lib/data";

const [S, posts] = await Promise.all([loadServices(), loadPosts()]);
---

<Classic
	title="Skincare Bimee | Esthetician in Plano & Dallas, TX"
	description="Skincare Bimee — facials, chemical peels, LED light therapy, Pro Pen Luminfusion and virtual skin consultations in Plano, TX. Be your own kind of beautiful."
	file="index.html"
	hero3d
	jsonld={jsonLd}
	services={S}
>
	<Fragment set:html={fixUrls(homeBody(S, posts))} />
</Classic>
