{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skincarebimee",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skincarebimee-emdash",
			"database_id": "a29c2142-da76-4fa4-bf53-0a77a3ad8e8b",
		},
	],
	// Media lives in KV (free plan). Ids come from the Cloudflare account.
	"kv_namespaces": [
		{ "binding": "MEDIA_KV", "id": "da029277c5974e319a6828079ffe058c" },
		{ "binding": "SESSION", "id": "71b1176bded04c0b94641bfb38428717" },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Production domains (DNS records are created by Cloudflare on deploy)
	"routes": [
		{ "pattern": "skincarebimee.com", "custom_domain": true },
		{ "pattern": "www.skincarebimee.com", "custom_domain": true },
	],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
