{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skincarebimee",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skincarebimee-emdash",
			"database_id": "a9754545-8497-4499-b1ce-a930915e00a5",
		},
	],
	// Media lives in KV (free plan). Ids come from the Cloudflare account.
	"kv_namespaces": [
		{ "binding": "MEDIA_KV", "id": "da029277c5974e319a6828079ffe058c" },
		{ "binding": "SESSION", "id": "71b1176bded04c0b94641bfb38428717" },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
